    <!-- الحذف النهائي -->
    <string name="delete_forever">حذف نهائي</string>
    <string name="delete_forever_title">حذف نهائي لا يمكن التراجع عنه</string>
    <string name="delete_forever_body">سيتم الكتابة فوق محتوى %1$d ملف ببيانات عشوائية ثم حذفها، فلا يمكن استعادتها بعد ذلك — لا بهذا التطبيق ولا بغيره.\n\nملاحظة: ذاكرة الفلاش تعيد توزيع الكتابة داخلياً، فقد تبقى نسخة فيزيائية في كتلة لم يعد النظام يشير إليها. هذا يمنع الاستعادة البرمجية المعتادة ولا يعادل مسحاً فيزيائياً مضموناً.</string>
    <string name="delete_forever_confirm">نعم، احذف نهائياً</string>
    <string name="delete_forever_done">تم مسح %1$d ملف نهائياً</string>
    <string name="delete_forever_partial">تم مسح %1$d، وفشل %2$d</string>
    <string name="delete_forever_consent">يحتاج %1$d ملف موافقة النظام على الحذف</string>

